# Neon Postgres. The app uses the pooled URL. Migrations and imports use the direct one.
# Non-local URLs are rewritten to sslmode=verify-full in src/lib/binder/db.ts.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Cloudflare R2, S3-compatible API. The bucket is private.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Resend. AUTH_EMAIL_FROM must be a verified sender on that Resend account.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# The only address that can request a sign-in code. Read at runtime; not hardcoded.
ADMIN_EMAIL=you@example.com

# Signs the binder session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Set to 1 to apply a migration, import, or face seed. Omit for a dry run.
BINDER_CONFIRM=

# Taught SigLIP vision ONNX for `npm run install:siglip-vision` / Vercel prebuild (see public/models/siglip2-base-ft20261112/README.md).
# SIGLIP_VISION_ONNX_PATH=
# SIGLIP_VISION_ONNX_URL=

# Optional scanner match tuning (SigLIP cosine scale). Defaults are set in src/lib/binder/scan.ts.
# See docs/scanner.md for what they mean.
# SCAN_MATCH_MIN_SIMILARITY=
# SCAN_MATCH_MIN_MARGIN=
# Only used when src/lib/scan/probe.json exists.
# SCAN_PROBE_MATCH_MIN_PROBABILITY=
# SCAN_PROBE_MIN_MARGIN=

# Only for `npm run fix:makes` writes to Sanity (an editor token). The site itself reads Sanity without a token.
# SANITY_API_TOKEN=

# Only for the Playwright layout test (`npm run test:review-fit` sets it). Leave unset in deployments.
# REVIEW_FIT=
